# Copy this file to .env and fill in your keys. Never commit the real .env file.

# Groq - free LLM inference (router, grader, generator, groundedness checker)
GROQ_API_KEY=your_groq_key_here

# Cohere - free tier embeddings + reranking
COHERE_API_KEY=your_cohere_key_here

# Pinecone - free tier vector database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX_NAME=documind-index

# LangSmith - free tier tracing (optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=documind
